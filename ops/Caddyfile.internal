# Internal Caddyfile for the shanuva-web container.
# TLS is terminated by the shared edge Caddy; this just serves static files.
:80 {
	root * /srv/www
	encode zstd gzip
	file_server

	header {
		Cache-Control "public, max-age=3600"
		-Server
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=604800"
}
